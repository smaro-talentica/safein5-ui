# Copy to .env.local (or the relevant .env.<mode>) and fill in values.
# Only variables prefixed with VITE_ are exposed to the client.

# App environment: development | staging | production
VITE_APP_ENV=development

# Base URL for API requests
VITE_API_BASE_URL=

# Speech-to-text transcription endpoint (see docs/BACKEND_SPEECH_TO_TEXT_SPEC.md).
# Leave unset while no backend exists — Transcription falls back to a mock transcript.
VITE_STT_ENDPOINT_URL=
